# Public site URL (used for metadata / hreflang)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase — stores quote requests (server-only; never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUOTE_BUCKET=quote-files

# Resend — emails each new quote request to the sales team
RESEND_API_KEY=
SALES_EMAIL=sales@example.com            # comma-separate for several recipients
QUOTE_FROM_EMAIL="NB Website <quotes@your-verified-domain.com>"
